[Unit]
Description=ERPM practice exam app
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/projects/erpm-exam-app/backend
EnvironmentFile=/root/projects/erpm-exam-app/backend/.env
ExecStart=/root/projects/erpm-exam-app/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8020
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
